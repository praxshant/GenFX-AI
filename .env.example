# ══════════════════════════════════════════════════════════════════════════════
# GenFX works with NO keys at all. Everything below is optional and only makes
# the pipeline better. Copy to .env and fill in what you have.
# ══════════════════════════════════════════════════════════════════════════════

# ── Stage 1: prompt → scene brief ─────────────────────────────────────────────
# Without any of these, a local heuristic parser is used. It works, but an LLM
# writes a much better image prompt and picks materials, lighting and camera.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local Ollama - free, private, no account. GenFX never installs or downloads
# it; if the daemon isn't running the cascade just moves on.
#   ollama pull llama3.2  &&  ollama serve
OLLAMA_ENABLED=1
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

LLM_PROVIDER_ORDER=openrouter,openai,huggingface,ollama

# ── Stage 2: scene brief → reference image ────────────────────────────────────
# Pollinations needs no key and is the default. A HF token adds a second path.
POLLINATIONS_ENABLED=1
POLLINATIONS_MODEL=flux
IMAGE_PROVIDER_ORDER=pollinations,huggingface

# ── Stage 3: image → 3D mesh ──────────────────────────────────────────────────
# A Hugging Face token is the single highest-value setting here: it raises the
# ZeroGPU quota on the image-to-3D Spaces from "anonymous" to a real daily
# allowance, and unlocks the textured pipelines.
#   https://huggingface.co/settings/tokens  (a read token is enough)
HUGGINGFACE_API_KEY=

GENFX_MESH_SPACES=frogleo/Image-to-3D,trellis-community/TRELLIS,tencent/Hunyuan3D-2.1
MESH_PROVIDER_ORDER=space,depth,relief
GENFX_MESH_TARGET_FACES=30000
GENFX_MESH_OCTREE=256

# ── Stage 4: mesh → .blend ────────────────────────────────────────────────────
# Leave BLENDER_PATH alone to use the pip `bpy` module (no Blender install).
# Set it to use a real Blender, e.g.
#   BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 4.5\blender.exe
BLENDER_PATH=blender
GENFX_BLEND_PREVIEW=1

# Split deployments: hand the .blend build to a separate GenFX worker Space.
# GENFX_BLEND_WORKER=https://your-name-genfx-worker.hf.space

# ── Storage ───────────────────────────────────────────────────────────────────
# On Hugging Face Spaces use a persistent path such as /data/runs.
# GENFX_RUNS_DIR=./runs
GENFX_MAX_RUNS=40
